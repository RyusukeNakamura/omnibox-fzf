{
  "manifest_version": 3,
  "name": "omnibox-fzf - Tabs, Bookmarks & History Search",
  "version": "1.2.0",
  "description": "Fast fuzzy search for your open tabs, bookmarks, and browsing history directly from the omnibox with keyword 'f'.",
  "omnibox": {
    "keyword": "f"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "history",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
